# Copy to .env (scripts/ops.ps1 setup does this and fills in random values).
# Never commit .env. All values below are placeholders.

# PostgreSQL password for the container database. Letters and digits only.
POSTGRES_PASSWORD=replace-with-random-value

# Demo account passwords used by the seed (at least 12 characters each).
SEED_ADMIN_PASSWORD=replace-with-random-value
SEED_TECHNICIAN_PASSWORD=replace-with-random-value
SEED_VIEWER_PASSWORD=replace-with-random-value

# Business timezone for dashboard day buckets.
APP_TIMEZONE=Asia/Jerusalem

# ---- Local development outside Docker only (npm run dev:server) ----
# DATABASE_URL=postgres://fieldline:<POSTGRES_PASSWORD>@127.0.0.1:54101/fieldline
# DEV_ORIGIN=http://127.0.0.1:5181
# Integration tests create and drop a database named fieldline_test on this server:
# TEST_DATABASE_URL=postgres://fieldline:<POSTGRES_PASSWORD>@127.0.0.1:54101/postgres
